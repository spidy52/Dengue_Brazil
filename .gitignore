# Ignore raw large dataset (617MB)
final_brazil_dengue.csv

# Ignore large output CSV files (keep data folder coords/geojson and summary metrics)
*.csv
!data/*.csv
!data/*.geojson
!final/outputs/metrics/*.csv
!final/outputs/csv/statewise_2025_improved_comparison.csv

# Ignore trained model binaries
*.joblib
climate/models/
dengue/models/

# Ignore compiled python cache
__pycache__/
*.pyc

# Ignore large generated HTML maps (>50MB each)
*.html

# Ignore OS files
.DS_Store
Thumbs.db
